{
  "name": "vulnscan-root",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "install": "cd frontend && npm install",
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && ../../venv/bin/python3 -m uvicorn main:app --reload --port 8000",
    "dev": "concurrently \"npm:backend\" \"npm:frontend\"",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
